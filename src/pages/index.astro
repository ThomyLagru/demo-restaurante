---
import "../styles/global.css";

const platos = [
  {
    nombre: "Bife de chorizo",
    descripcion: "350g de carne madurada, cocida en parrilla a leña con guarnición a elección.",
    precio: 18500,
    imagen: "/images/plato-1.jpg"
  },
  {
    nombre: "Empanadas mendocinas",
    descripcion: "Seis unidades horneadas, masa criolla, relleno de carne cortada a cuchillo.",
    precio: 9800,
    imagen: "/images/plato-2.jpg"
  },
  {
    nombre: "Sorrentinos de osobuco",
    descripcion: "Pasta casera rellena de osobuco braseado, salsa de hongos y manteca dorada.",
    precio: 14500,
    imagen: "/images/plato-3.jpg"
  },
  {
    nombre: "Provoleta a las brasas",
    descripcion: "Disco de provolone parrillero con tomate confitado, oliva y orégano fresco.",
    precio: 8500,
    imagen: "/images/plato-4.jpg"
  },
  {
    nombre: "Flan mixto casero",
    descripcion: "Flan de huevo con dulce de leche, crema chantilly y nuez tostada.",
    precio: 5800,
    imagen: "/images/plato-5.jpg"
  },
  {
    nombre: "Malbec de la casa",
    descripcion: "Valle de Uco, servido a 16°. Suave, con notas a frutos rojos y final largo.",
    precio: 4200,
    imagen: "/images/plato-6.jpg"
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bistró La Plaza | Cocina argentina con alma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900" style="font-family: 'Inter', sans-serif;">

    <!-- ============== NAVBAR ============== -->
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="#inicio" class="text-white font-bold text-xl" style="font-family: 'Playfair Display', serif;">
          Bistró La Plaza
        </a>
        <!-- Links desktop -->
        <div class="hidden md:flex items-center gap-8 text-white/90">
          <a href="#nosotros" class="hover:text-white transition text-sm font-medium tracking-wide">Nosotros</a>
          <a href="#menu" class="hover:text-white transition text-sm font-medium tracking-wide">Menú</a>
          <a href="#horarios" class="hover:text-white transition text-sm font-medium tracking-wide">Horarios</a>
          <a href="#contacto" class="hover:text-white transition text-sm font-medium tracking-wide">Contacto</a>
          <a href="#contacto" class="bg-amber-700 hover:bg-amber-800 transition px-5 py-2 rounded-full text-sm font-medium">
            Reservar
          </a>
        </div>
        <!-- Mobile: solo botón -->
        <a href="#contacto" class="md:hidden bg-amber-700 hover:bg-amber-800 transition px-4 py-2 rounded-full text-sm font-medium text-white">
          Reservar
        </a>
      </div>
    </nav>

    <!-- ============== HERO ============== -->
    <section id="inicio" class="relative h-screen min-h-[600px] flex items-center justify-center text-center text-white overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero.jpg');"></div>
      <div class="absolute inset-0 bg-stone-950/60"></div>

      <div class="relative z-10 max-w-3xl px-6">
        <p class="italic text-amber-200 text-lg mb-4" style="font-family: 'Playfair Display', serif;">Desde 2014</p>
        <h1 class="text-6xl md:text-7xl font-bold mb-6 leading-tight" style="font-family: 'Playfair Display', serif;">
          Bistró La Plaza
        </h1>
        <p class="text-xl text-stone-200 mb-10 max-w-xl mx-auto leading-relaxed">
          Cocina argentina con alma. Carnes a las brasas, pastas caseras y vinos de altura, en el corazón de San Telmo.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="#contacto" class="bg-amber-700 hover:bg-amber-800 transition px-8 py-4 rounded-full font-medium">
            Reservar mesa
          </a>
          <a href="#menu" class="border border-white/40 hover:bg-white/10 transition px-8 py-4 rounded-full font-medium">
            Ver menú
          </a>
        </div>
      </div>
    </section>

    <!-- ============== SOBRE NOSOTROS ============== -->
    <section id="nosotros" class="py-24 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="italic text-amber-700 text-lg mb-3" style="font-family: 'Playfair Display', serif;">
            Nuestra historia
          </p>
          <h2 class="text-5xl font-bold mb-6 text-stone-900 leading-tight" style="font-family: 'Playfair Display', serif;">
            Diez años haciendo lo que sabemos.
          </h2>
          <p class="text-stone-600 text-lg leading-relaxed mb-4">
            Abrimos en 2014 con una idea simple: cocinar como cocina la abuela, pero con la disciplina de un restaurante de verdad. La carne la elegimos cada mañana en el frigorífico, la pasta la estiramos en casa, y los vinos los seleccionamos con bodegueros que conocemos hace años.
          </p>
          <p class="text-stone-600 text-lg leading-relaxed">
            El chef Martín Robles dirige la cocina desde el primer día. Cada plato del menú pasó por años de prueba antes de llegar a tu mesa.
          </p>
        </div>
        <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-xl">
          <img src="/images/interior.jpg" alt="Interior de Bistró La Plaza" class="w-full h-full object-cover" />
        </div>
      </div>
    </section>

  <!-- ============== MENÚ ============== -->
  <section id="menu" class="py-24 px-6 bg-stone-100">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="italic text-amber-700 text-lg mb-3" style="font-family: 'Playfair Display', serif;">
          Nuestra carta
        </p>
        <h2 class="text-5xl font-bold text-stone-900" style="font-family: 'Playfair Display', serif;">
          Algunos destacados
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {platos.map((plato) => (
          <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={plato.imagen}
                alt={plato.nombre}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-2 gap-3">
                <h3 class="text-2xl font-bold text-stone-900 leading-tight" style="font-family: 'Playfair Display', serif;">
                  {plato.nombre}
                </h3>
                <span class="font-semibold text-amber-700 whitespace-nowrap">
                  ${plato.precio.toLocaleString('es-AR')}
                </span>
              </div>
              <p class="text-stone-600 leading-relaxed">{plato.descripcion}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== HORARIOS ============== -->
  <section id="horarios" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-start">

      <div>
        <p class="italic text-amber-700 text-lg mb-3" style="font-family: 'Playfair Display', serif;">Dónde encontrarnos</p>
        <h2 class="text-4xl font-bold mb-8 text-stone-900" style="font-family: 'Playfair Display', serif;">
          Horarios y dirección
        </h2>

        <div class="mb-8">
          <div class="flex justify-between py-3 border-b border-stone-100">
            <span class="font-medium text-stone-700">Martes a Viernes</span>
            <span class="text-stone-600">12:00 – 15:30 / 20:00 – 23:30</span>
          </div>
          <div class="flex justify-between py-3 border-b border-stone-100">
            <span class="font-medium text-stone-700">Sábados</span>
            <span class="text-stone-600">12:00 – 16:00 / 19:30 – 00:00</span>
          </div>
          <div class="flex justify-between py-3 border-b border-stone-100">
            <span class="font-medium text-stone-700">Domingos</span>
            <span class="text-stone-600">12:00 – 16:00</span>
          </div>
          <div class="flex justify-between py-3">
            <span class="font-medium text-stone-700">Lunes</span>
            <span class="text-amber-700 font-medium">Cerrado</span>
          </div>
        </div>

        <div class="bg-stone-50 rounded-2xl p-6">
          <p class="font-semibold text-stone-900 mb-1">Defensa 961, San Telmo</p>
          <p class="text-stone-600">Ciudad de Buenos Aires</p>
          <a href="tel:+541143001234" class="block mt-3 text-amber-700 hover:text-amber-800 transition font-medium">
            +54 11 4300-1234
          </a>
          <a href="mailto:reservas@bistroplaza.com.ar" class="block mt-1 text-amber-700 hover:text-amber-800 transition">
            reservas@bistroplaza.com.ar
          </a>
        </div>
      </div>

      <!-- Mapa Google -->
      <div class="rounded-2xl overflow-hidden shadow-lg min-h-[450px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3284.017019855764!2d-58.37084492426664!3d-34.6218565!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccab7658b2e21%3A0x5e7b27b91b8d1dc0!2sDefensa%20961%2C%20C1065%20Cdad.%20Aut%C3%B3noma%20de%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1714500000000!5m2!1ses!2sar"
          width="100%"
          height="100%"
          style="border:0; min-height: 450px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ============== CONTACTO ============== -->
  <section id="contacto" class="py-24 px-6 bg-stone-900 text-white">
    <div class="max-w-2xl mx-auto text-center">
      <p class="italic text-amber-400 text-lg mb-3" style="font-family: 'Playfair Display', serif;">Hacé tu reserva</p>
      <h2 class="text-5xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">¿Nos vemos pronto?</h2>
      <p class="text-stone-400 mb-12">Reservá tu mesa o escribinos con cualquier consulta. Te respondemos en menos de 24 horas.</p>

      <form action="https://formspree.io/f/xgodlogg" method="POST" class="space-y-4 text-left">
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-300 mb-2">Nombre</label>
            <input type="text" name="nombre" required placeholder="Juan García"
              class="w-full bg-stone-800 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-300 mb-2">Email</label>
            <input type="email" name="email" required placeholder="juan@email.com"
              class="w-full bg-stone-800 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition" />
          </div>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-stone-300 mb-2">Teléfono (opcional)</label>
            <input type="tel" name="telefono" placeholder="+54 11 ..."
              class="w-full bg-stone-800 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-300 mb-2">Personas</label>
            <select name="personas" class="w-full bg-stone-800 border border-stone-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-600 transition">
              <option>2 personas</option>
              <option>3-4 personas</option>
              <option>5-6 personas</option>
              <option>Más de 6</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-300 mb-2">Mensaje</label>
          <textarea name="mensaje" rows="4" placeholder="¿Alguna preferencia o consulta especial?"
            class="w-full bg-stone-800 border border-stone-700 rounded-xl px-4 py-3 text-white placeholder-stone-500 focus:outline-none focus:border-amber-600 transition resize-none"></textarea>
        </div>
        <button type="submit"
          class="w-full bg-amber-700 hover:bg-amber-800 active:scale-95 transition-all py-4 rounded-xl font-semibold text-lg">
          Enviar reserva →
        </button>
      </form>
    </div>
  </section>

  <!-- ============== FOOTER ============== -->
  <footer class="bg-stone-950 text-stone-400 py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
      <div>
        <p class="text-white font-bold text-xl mb-1" style="font-family: 'Playfair Display', serif;">
          Bistró La Plaza
        </p>
        <p class="text-sm">Defensa 961, San Telmo · Buenos Aires</p>
      </div>
      <div class="flex gap-8">
        <a href="#" class="hover:text-white transition text-sm font-medium">Instagram</a>
        <a href="#" class="hover:text-white transition text-sm font-medium">Facebook</a>
        <a href="https://wa.me/541143001234" target="_blank" class="hover:text-white transition text-sm font-medium">WhatsApp</a>
      </div>
      <p class="text-xs text-stone-600">© 2026 Bistró La Plaza. Todos los derechos reservados.</p>
    </div>
  </footer>




  <script>
    const navbar = document.getElementById('navbar');
    if (navbar) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          navbar.classList.add('bg-stone-900/95', 'backdrop-blur-sm', 'shadow-lg');
          navbar.classList.remove('bg-transparent');
        } else {
          navbar.classList.remove('bg-stone-900/95', 'backdrop-blur-sm', 'shadow-lg');
          navbar.classList.add('bg-transparent');
        }
      });
    }
  </script>

  </body>
</html>